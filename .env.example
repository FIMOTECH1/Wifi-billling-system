APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Direct Vodacom M-Pesa (Tanzania). Leave disabled until Vodacom supplies the
# collection shortcode, credentials and callback/IP-whitelist details.
MPESA_ENABLED=false
MPESA_BASE_URL=
MPESA_API_KEY=
MPESA_API_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback"
MPESA_TIMEOUT_MINUTES=3

# Abliner mobile money collection (Tanzania). Get keys from the Abliner dashboard.
ABLINER_ENABLED=false
ABLINER_BASE_URL=https://abliner.net/api/v1
ABLINER_API_KEY=
ABLINER_WEBHOOK_SECRET=
# Public HTTPS URL that Abliner can call, for example:
# https://your-domain.com/payments/abliner/callback
ABLINER_CALLBACK_URL=
ABLINER_MIN_AMOUNT=500
ABLINER_MAX_AMOUNT=3000000
ABLINER_TIMEOUT_MINUTES=15
ABLINER_PAYOUT_ENABLED=false
ABLINER_PAYOUT_DRY_RUN=true
# Fallback only. The Settings page saves the active number in the database.
# If a value exists in the database, this line is not used.
ABLINER_PAYOUT_PHONE=
ABLINER_PAYOUT_MIN_AMOUNT=1000
ABLINER_PAYOUT_FEE_PERCENT=4
